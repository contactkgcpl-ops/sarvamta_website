# Apache .htaccess configuration for SARVAMTA Food and Spices Private Limited
# Domain: https://sarvamtafoodandspice.com/

# 1. Prevent Directory Browsing
Options -Indexes

# 2. Rewrite Engine & Clean URLs (No .html extension)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # A. Redirect HTTP to HTTPS (Production domain)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(?:www\.)?sarvamtafoodandspice\.com$ [NC]
  RewriteRule ^(.*)$ https://sarvamtafoodandspice.com/$1 [L,R=301]

  # B. Redirect www to non-www
  RewriteCond %{HTTP_HOST} ^www\.sarvamtafoodandspice\.com$ [NC]
  RewriteRule ^(.*)$ https://sarvamtafoodandspice.com/$1 [L,R=301]

  # C. Redirect /index.html or /index to root /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(?:\.html)?[\s?] [NC]
  RewriteRule ^index(?:\.html)?$ ./ [R=301,L]

  # D. Remove .html from visible URL (301 redirect /page.html -> /page)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L,NE]

  # E. Internally load .html file for clean extensionless URLs (/page -> page.html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*?)/?$ $1.html [L,QSA]
</IfModule>

# 3. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Gzip / Deflate Compression (Speed & Core Web Vitals)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# 5. Browser Caching (Expires Headers)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
